int calc(int n)
{
    int i;
    int sum;

    i = 1;
    sum = 0;

    while (i <= n)
    {
        if (i % 2 == 0)
        {
            sum = sum + i * 2;
        }
        else
        {
            sum = sum - i;
        }

        i = i + 1;
    }

    return sum;
}

int main()
{
    int n;
    int ans;

    n = getint();
    ans = calc(n);

    putint(ans);
    putch(10);

    return 0;
}